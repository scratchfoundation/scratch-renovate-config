{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "github>scratchfoundation/scratch-renovate-config:base",
    ":automergeStableNonMajor",
    ":automergeDigest"
  ],

  "lockFileMaintenance": {
    "description": "Automatically merge lock file updates. Tuned for less noise.",
    "automerge": true,
    "extends": [":automergeBranch", "schedule:automergeDaily"]
  },

  "packageRules": [
    {
      "description": "enable auto-merge for 'pin dependencies' updates",
      "matchUpdateTypes": ["pin"],
      "automerge": true,
      "rebaseWhen": "auto"
    },
    {
      "description": "keep automerged minor and patch updates (see :automergeStableNonMajor) rebased so they can merge",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor", "patch"],
      "rebaseWhen": "auto"
    },
    {
      "description": "keep automerged digest updates (see :automergeDigest) rebased so they can merge",
      "matchUpdateTypes": ["digest"],
      "rebaseWhen": "auto"
    },
    {
      "description": "enable auto-merge for all updates of internal dependencies which don't yet use semver",
      "matchCurrentVersion": "/^0.*-prerelease/",
      "matchSourceUrls": [
        "https://github.com/scratchfoundation/**",
        "https://github.com/LLK/**"
      ],
      "automerge": true,
      "rebaseWhen": "auto"
    }
  ]
}
