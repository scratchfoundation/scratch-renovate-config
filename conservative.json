{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "github>scratchfoundation/scratch-renovate-config:base"
  ],

  "lockFileMaintenance": {
    "description": "Automatically merge lock file updates (in-range updates).",
    "automerge": true
  },

  "packageRules": [
    {
      "description": "enable auto-merge for minor and patch updates of internal dependencies which use semver",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor", "patch"],
      "matchSourceUrls": [
        "https://github.com/scratchfoundation/**",
        "https://github.com/LLK/**"
      ],
      "automerge": true,
      "rebaseWhen": "auto"
    },
    {
      "description": "enable auto-merge for all updates of internal dependencies which don't yet use semver",
      "matchCurrentVersion": "/^0.*-prerelease/",
      "matchSourceUrls": [
        "https://github.com/scratchfoundation/**",
        "https://github.com/LLK/**"
      ],
      "automerge": true,
      "rebaseWhen": "auto"
    }
  ]
}
